---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects | Fang & Forge Productions">
  <section class="page-header">
    <div class="container">
      <div class="eyebrow">Projects</div>
      <h1>What we're building.</h1>
      <p class="lead">
        Fang & Forge projects can include tabletop systems, virtual tabletop work, books,
        worldbuilding tools, and other creative releases.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <article class="card">
        <h2>Veyra World Platform</h2>
        <p>Migration and expansion of the existing Veyra web experience.</p>
      </article>

      <article class="card">
        <h2>Foundry VTT Work</h2>
        <p>Current experimentation and development around virtual tabletop systems and tooling.</p>
      </article>

      <article class="card">
        <h2>Original Fang & Forge VTT</h2>
        <p>A longer-term project to design our own digital tabletop experience.</p>
        <span class="muted">Planning stage</span>
      </article>
    </div>
  </section>
</BaseLayout>
