---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Worlds | Fang & Forge Productions">
  <section class="page-header">
    <div class="container">
      <div class="eyebrow">Our worlds</div>
      <h1>Settings built to be explored.</h1>
      <p class="lead">
        Each Fang & Forge world will have its own lore, characters, locations, stories, and
        projects while remaining part of the larger studio.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <article class="card">
        <h2>Veyra</h2>
        <p>The first world being developed and migrated into the Fang & Forge platform.</p>
        <a href="/worlds/veyra">Explore Veyra →</a>
      </article>

      <article class="card">
        <h2>Future World</h2>
        <p>Reserved for the next setting created under Fang & Forge Productions.</p>
        <span class="muted">Coming later</span>
      </article>
    </div>
  </section>
</BaseLayout>
