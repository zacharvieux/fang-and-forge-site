---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Veyra | Fang & Forge Productions">
  <section class="hero">
    <div class="container copy">
      <div class="eyebrow">A Fang & Forge world</div>
      <h1>Veyra</h1>
      <p class="lead">
        Veyra is the first original world being brought into Fang & Forge Productions.
      </p>
      <p>
        This is the new home that will eventually connect Veyra's existing lore pages, locations,
        characters, maps, campaigns, and future releases.
      </p>
      <div class="actions">
        <a class="button secondary" href={`${base}worlds`}>Back to worlds</a>
      </div>
    </div>
  </section>
</BaseLayout>
