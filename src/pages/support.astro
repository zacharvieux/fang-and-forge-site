---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Support | Fang & Forge Productions">
  <section class="page-header">
    <div class="container copy">
      <div class="eyebrow">Support the studio</div>
      <h1>A supporter area is part of the roadmap.</h1>
      <p class="lead">
        We plan to add ways for people to support Fang & Forge and receive access to selected
        behind-the-scenes material, downloads, previews, and other member content.
      </p>
      <p>
        Patreon or another membership system can be connected later. We are keeping the first
        version simple so we can establish the studio, worlds, and project platform first.
      </p>
    </div>
  </section>
</BaseLayout>
